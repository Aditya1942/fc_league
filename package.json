{
  "name": "fc-league",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "emulators": "sh scripts/emulators.sh",
    "deploy": "npm run build && firebase deploy --only auth,firestore,hosting",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --only firestore 'vitest run tests/rules'"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
